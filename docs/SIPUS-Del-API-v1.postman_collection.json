{
	"info": {
		"_postman_id": "9924a18d-f682-411a-8bb7-c328db599026",
		"name": "SIPUS-Del API v1 - Web Services & Sirkulasi",
		"description": "Koleksi Postman resmi untuk Praktikum Minggu 9 Mata Kuliah Pemrograman dan Pengujian Aplikasi Web (12S3101) - Institut Teknologi Del.\nMencakup pengujian Layanan SOAP Clearance Yudisium, RESTful Provider Katalog Buku & Sirkulasi ACID, Bearer Token Sanctum, HATEOAS Level 3, RFC 7807, dan Consumer Eksternal OpenLibrary.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Layanan SOAP (Clearance Yudisium)",
			"item": [
				{
					"name": "1.1 GET WSDL Kontrak Layanan",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://127.0.0.1:8000/soap/sipus.wsdl",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["soap", "sipus.wsdl"]
						},
						"description": "Mengambil dokumen kontrak WSDL XML resmi layanan bebas pustaka yudisium."
					}
				},
				{
					"name": "1.2 POST Cek Status Clearance - Mahasiswa Ada Pinjaman (Bona)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/clearance\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <m:nim_peminjam>12S22001</m:nim_peminjam>\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>",
							"options": {
								"raw": {
									"language": "xml"
								}
							}
						},
						"url": {
							"raw": "http://127.0.0.1:8000/soap/sipus",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["soap", "sipus"]
						},
						"description": "NIM 12S22001 memiliki 1 buku berstatus dipinjam sehingga is_cleared bernilai false."
					}
				},
				{
					"name": "1.3 POST Cek Status Clearance - Mahasiswa Bebas Pinjaman (Nikah)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/clearance\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <m:nim_peminjam>12S24041</m:nim_peminjam>\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>",
							"options": {
								"raw": {
									"language": "xml"
								}
							}
						},
						"url": {
							"raw": "http://127.0.0.1:8000/soap/sipus",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["soap", "sipus"]
						},
						"description": "NIM 12S24041 tidak memiliki pinjaman aktif sehingga is_cleared bernilai true."
					}
				},
				{
					"name": "1.4 POST Cek Status Clearance - Error Fault (Elemen Kosong)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:m=\"http://sipus.del.ac.id/soap/clearance\">\n    <soap:Body>\n        <m:CheckClearanceStatusRequest>\n            <m:nim_peminjam></m:nim_peminjam>\n        </m:CheckClearanceStatusRequest>\n    </soap:Body>\n</soap:Envelope>",
							"options": {
								"raw": {
									"language": "xml"
								}
							}
						},
						"url": {
							"raw": "http://127.0.0.1:8000/soap/sipus",
							"protocol": "http",
							"host": ["127", "0", "0", "1"],
							"port": "8000",
							"path": ["soap", "sipus"]
						},
						"description": "Uji pengembalian soap:Fault dengan status HTTP 500 saat nim_peminjam kosong."
					}
				}
			]
		},
		{
			"name": "2. Otentikasi Stateless Sanctum",
			"item": [
				{
					"name": "2.1 POST Login Pustakawan Sukses",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.access_token) {",
									"        pm.collectionVariables.set('token', json.data.access_token);",
									"        console.log('Token otomatis tersimpan: ' + json.data.access_token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"pustakawan@del.ac.id\",\n    \"password\": \"password123\",\n    \"device_name\": \"postman-desktop\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Login pustakawan untuk mendapatkan token Bearer Sanctum."
					}
				},
				{
					"name": "2.2 POST Login Kredensial Salah (401 RFC 7807)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"pustakawan@del.ac.id\",\n    \"password\": \"password_salah\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Memastikan respon gagal login berstatus 401 dengan format RFC 7807."
					}
				},
				{
					"name": "2.3 GET Profil Pustakawan Aktif",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						},
						"description": "Mengakses profil pustakawan menggunakan token Bearer Sanctum."
					}
				},
				{
					"name": "2.4 GET Profil Tanpa Token (401 RFC 7807)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						},
						"description": "Memastikan akses rute terproteksi tanpa token menghasilkan error 401 RFC 7807."
					}
				},
				{
					"name": "2.5 POST Logout Pustakawan",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						},
						"description": "Mencabut token Bearer aktif di sisi server."
					}
				}
			]
		},
		{
			"name": "3. REST Provider Katalog Buku",
			"item": [
				{
					"name": "3.1 GET Koleksi Buku Terpaginasi & Filter",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus?per_page=5&sort=stok&dir=desc",
							"host": ["{{base_url}}"],
							"path": ["bukus"],
							"query": [
								{ "key": "per_page", "value": "5" },
								{ "key": "sort", "value": "stok" },
								{ "key": "dir", "value": "desc" }
							]
						},
						"description": "Membaca daftar buku terpaginasi dengan sorting stok menurun."
					}
				},
				{
					"name": "3.2 GET Detail Buku ID 1 (Stok Ada - HATEOAS Lengkap)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "Buku dengan stok > 0 memuat tautan HATEOAS pinjam_buku di dalam _links."
					}
				},
				{
					"name": "3.3 GET Detail Buku ID 3 (Stok 0 - HATEOAS pinjam_buku Hilang)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus/3",
							"host": ["{{base_url}}"],
							"path": ["bukus", "3"]
						},
						"description": "Buku dengan stok = 0 otomatis menyembunyikan tautan HATEOAS pinjam_buku."
					}
				},
				{
					"name": "3.4 GET Detail Buku Tidak Ditemukan (404 RFC 7807)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus/9999",
							"host": ["{{base_url}}"],
							"path": ["bukus", "9999"]
						},
						"description": "Memastikan respon 404 berformat application/problem+json standar RFC 7807."
					}
				},
				{
					"name": "3.5 POST Tambah Buku Baru (201 Created + Header Location)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isbn\": \"978-623-00-1122-8\",\n    \"judul\": \"Arsitektur Web Services dan REST API Modern\",\n    \"penulis\": \"Chandro Pardede\",\n    \"penerbit\": \"Del Press\",\n    \"tahun_terbit\": 2024,\n    \"kategori_id\": 1,\n    \"stok\": 10,\n    \"sinopsis\": \"Panduan mendalam implementasi REST API dan HATEOAS pada Laravel 11.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/bukus",
							"host": ["{{base_url}}"],
							"path": ["bukus"]
						},
						"description": "Menambahkan buku baru, merespons 201 Created dan menyertakan header Location."
					}
				},
				{
					"name": "3.6 POST Tambah Buku Gagal Validasi (422 RFC 7807)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isbn\": \"\",\n    \"judul\": \"Ab\",\n    \"stok\": -5\n}"
						},
						"url": {
							"raw": "{{base_url}}/bukus",
							"host": ["{{base_url}}"],
							"path": ["bukus"]
						},
						"description": "Uji penolakan 422 Unprocessable Content dengan rincian kesalahan per kolom."
					}
				},
				{
					"name": "3.7 PUT Ganti Utuh Representasi Buku (Full Replacement)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PUT",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"isbn\": \"978-602-001-101-1\",\n    \"judul\": \"Clean Code: Edisi Revisi Komprehensif\",\n    \"penulis\": \"Robert C. Martin\",\n    \"penerbit\": \"Prentice Hall Publishing\",\n    \"tahun_terbit\": 2020,\n    \"kategori_id\": 1,\n    \"stok\": 5,\n    \"sinopsis\": \"Edisi pembaruan teknik koding bersih.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "PUT semantik: seluruh field representasi dikirim lengkap untuk menimpa state buku."
					}
				},
				{
					"name": "3.8 PATCH Ubah Sebagian Atribut Buku (Partial Update)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"stok\": 12\n}"
						},
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "PATCH semantik: cukup kirim kolom stok saja tanpa merusak atribut lainnya."
					}
				},
				{
					"name": "3.9 PATCH Gagal Payload Kosong (400 Bad Request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "Uji penolakan 400 Bad Request jika payload PATCH kosong."
					}
				},
				{
					"name": "3.10 DELETE Buku Sedang Dipinjam Ditolak (409 Conflict)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "Menolak penghapusan buku yang masih memiliki transaksi pinjam aktif (409 Conflict)."
					}
				},
				{
					"name": "3.11 DELETE Buku Sukses (204 No Content)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "DELETE",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/bukus/21",
							"host": ["{{base_url}}"],
							"path": ["bukus", "21"]
						},
						"description": "Menghapus buku yang tidak memiliki pinjaman aktif, mereturn status 204 No Content tanpa body."
					}
				}
			]
		},
		{
			"name": "4. REST Transaksi Sirkulasi ACID",
			"item": [
				{
					"name": "4.1 GET Riwayat Peminjaman Terpaginasi",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "GET",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/peminjamans?status=dipinjam",
							"host": ["{{base_url}}"],
							"path": ["peminjamans"],
							"query": [
								{ "key": "status", "value": "dipinjam" }
							]
						},
						"description": "Mengambil daftar transaksi peminjaman buku yang berstatus dipinjam."
					}
				},
				{
					"name": "4.2 POST Peminjaman Buku Sukses (201 Created)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"buku_id\": 2,\n    \"nim_peminjam\": \"12S24041\",\n    \"nama_peminjam\": \"Nikah Suchia\",\n    \"durasi_hari\": 7\n}"
						},
						"url": {
							"raw": "{{base_url}}/peminjamans",
							"host": ["{{base_url}}"],
							"path": ["peminjamans"]
						},
						"description": "Mencatat peminjaman buku atomik dengan lockForUpdate, stok berkurang 1."
					}
				},
				{
					"name": "4.3 POST Peminjaman Gagal - Duplikat Pinjaman Aktif (409 Conflict)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"buku_id\": 2,\n    \"nim_peminjam\": \"12S24041\",\n    \"nama_peminjam\": \"Nikah Suchia\",\n    \"durasi_hari\": 7\n}"
						},
						"url": {
							"raw": "{{base_url}}/peminjamans",
							"host": ["{{base_url}}"],
							"path": ["peminjamans"]
						},
						"description": "Menolak peminjaman jika mahasiswa masih memiliki pinjaman aktif buku yang sama."
					}
				},
				{
					"name": "4.4 POST Peminjaman Gagal - Stok Habis (422 RFC 7807)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "POST",
						"header": [
							{ "key": "Accept", "value": "application/json" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"buku_id\": 3,\n    \"nim_peminjam\": \"12S24041\",\n    \"nama_peminjam\": \"Nikah Suchia\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/peminjamans",
							"host": ["{{base_url}}"],
							"path": ["peminjamans"]
						},
						"description": "Menolak peminjaman pada buku ID 3 yang stoknya 0, mengembalikan 422 Unprocessable Content."
					}
				},
				{
					"name": "4.5 PATCH Pengembalian Buku Sukses (200 OK)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
							"raw": "{{base_url}}/peminjamans/1/kembalikan",
							"host": ["{{base_url}}"],
							"path": ["peminjamans", "1", "kembalikan"]
						},
						"description": "Mengembalikan buku secara atomik, mengubah status jadi dikembalikan, dan menambah stok (+1)."
					}
				},
				{
					"name": "4.6 PATCH Pengembalian Ganda Ditolak (409 Conflict)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
						},
						"method": "PATCH",
						"header": [
